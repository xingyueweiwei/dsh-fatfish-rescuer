<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    BigFatFishRescuer - application manifest (embedded via csc /win32manifest:).

    The assemblyIdentity version attribute is kept in sync by the build tool
    tools\MakeVersionRes.exe, which reads the single source of truth
    (src\DshCore.cs -> public const string AppVersion) on every build.

    This file is intentionally pure ASCII so that no encoding assumption
    (BOM / ANSI code page) can corrupt the embedded manifest.
  -->
  <assemblyIdentity type="win32" name="BigFatFishRescuer" version="5.0.2.0" processorArchitecture="*"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        ★★ 2026-09-20 撤销 DPI 感知声明（主人反馈：按钮文字看不全，要恢复原来的大小）。
        详见 src/DshCore.cs 里 Selftest 那一段的「DPI 感知判据」注释；
        一句话：本机缩放 150%，声明感知后字按 144 DPI 渲染而控件尺寸是写死的像素值，
        文字被挤出按钮（「装后体检」只剩「装后体」）。撤掉声明即回到原行为。
        自检判据：进程读到的屏幕 DPI 必须是 96（见自检第「DPI 感知」条）。
      -->
      <!-- long path support (Windows 10 1607+) —— 这条与 DPI 无关，保留 -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
